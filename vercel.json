{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://todo-app-backend-7dxg.onrender.com/"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}